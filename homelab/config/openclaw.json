{
  // OpenClaw config for Frack — cluster-resident on `thebeast`.
  // The business operator. Runs the 12 production apps + customer
  // ops + social + finance.
  //
  // Was previously laptop-resident (M1 Max). 2026-04-30 migrated to
  // a Deployment in the K3s cluster scheduled to thebeast.
  // The MacBook keeps `openclaw` installed as a thin client only.

  models: {
    mode: "merge",
    providers: {
      // Override the built-in `openai` provider so the OpenClaw embedded
      // harness — which falls back to `openai/gpt-5.5` for skill creation,
      // commit-message synthesis, etc. when the agentRuntime is left
      // unspecified — routes through the same LiteLLM gateway as the
      // main agent. The matching `gpt-5.5 -> chat` alias lives in
      // ~/git/homelab/argocd/apps/_inference/40-litellm-config.yaml
      // (model_group_alias). Without this override the embedded run
      // hits api.openai.com directly with our LITELLM_API_KEY -> 401.
      openai: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "OPENAI_API_KEY" },
        api: "openai-completions",
        models: [
          {
            id: "gpt-5.5",
            name: "Embedded harness fallback — alias to LiteLLM chat",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192,
          }
        ]
      },
      litellm: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "LITELLM_API_KEY" },
        api: "openai-completions",
        models: [
          {
            id: "chat",
            name: "LiteLLM chat (qwen2.5-coder:32b via vllm-chat)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192,
          },
          {
            id: "code",
            name: "LiteLLM code (falls through to chat until vllm-coder unparked)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192,
          },
          {
            id: "long",
            name: "LiteLLM long (falls through to chat until vllm-long unparked)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 131072,
            maxTokens: 8192,
          },
          {
            id: "embed",
            name: "LiteLLM embed (tei-embed)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 8192,
          },
          {
            id: "rerank",
            name: "LiteLLM rerank (tei-rerank)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 8192,
          }
        ]
      },
      // Ollama on thebeast — direct fallback when LiteLLM is unhealthy.
      // The pod can reach the host via the K3s host network or the
      // explicit nodeSelector + hostNetwork pair (TBD on best path).
      ollama: {
        baseUrl: "http://thebeast.local:11434/v1",
        apiKey: "ollama-local",
        api: "openai-completions",
        models: [
          {
            id: "qwen3-coder:30b",
            name: "Qwen3 Coder 30B (MoE) — local fallback",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 262144,
            maxTokens: 8192,
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        primary: "litellm/chat",
        fallbacks: ["litellm/long", "ollama/qwen3-coder:30b"],
      },
      // Embedded harness (skill creation, commit-message synthesis, etc.)
      // defaulted to gpt-5.5/openai upstream and hit api.openai.com
      // directly with our LITELLM_API_KEY → 401. Pin it at the same
      // LiteLLM front door the main agent uses.
      agentRuntime: {
        defaults: {
          provider: "litellm",
          model: "chat",
        },
      },
      workspace: "/root/.openclaw/workspace",
      compaction: { mode: "safeguard" },
      contextPruning: { mode: "cache-ttl", ttl: "1h" },
      maxConcurrent: 4,
      thinkingDefault: "low",
      heartbeat: {
        every: "30m",
        offsetMinutes: 10,  // :10 and :40 to avoid Frick (:00 :30) and Sancho (:20 :50)
        target: "last",
      },
      memorySearch: {
        enabled: true,
        sources: ["memory", "sessions"],
        // Multi-graph: own graph (RW), Leo's PKM (R+restricted W),
        // siblings R-only. Mounted via hostPath on thebeast (per
        // host-side Syncthing setup — see scripts/agents/setup-host-syncthing.sh).
        extraPaths: [
          "/srv/graphs/frack/pages/ai-memory",
          "/srv/graphs/frack/journals",
          "/srv/graphs/frack/pages",
          "/srv/graphs/leo/pages",
          "/srv/graphs/leo/journals",
          "/srv/graphs/frick/pages/ai-memory",
          "/srv/graphs/frick/journals",
          "/srv/graphs/sancho/pages/ai-memory",
          "/srv/graphs/sancho/journals",
        ],
        provider: "litellm",
        litellm: {
          embedModel: "embed",
          rerankModel: "rerank",
        },
        fallback: "local",
        local: {
          modelPath: "hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf",
        },
        // Postgres pgvector backing store (via DATABASE_URL secret)
        store: {
          backend: "postgres-pgvector",
          urlEnv: "DATABASE_URL",
          schema: "frack_memory",
        },
        sync: {
          watch: true,
          watchDebounceMs: 2000,
          onSessionStart: true,
          onSearch: true,
        },
        query: {
          hybrid: {
            enabled: true,
            vectorWeight: 0.7,
            textWeight: 0.3,
          },
        },
      },
    },
    list: [
      {
        id: "main",
        default: true,
        identity: {
          name: "Frack",
          theme: "business operator — runs the 12 production apps + customer ops + social + finance",
          emoji: "💼",
        },
      }
    ],
  },

  tools: {
    profile: "full",  // schema enum: minimal|coding|messaging|full. Frack runs production.
    allow: ["read", "exec", "write", "edit", "web_search", "browser"],
    exec: {
      host: "gateway",
      // ASK MODE: schema enum off|on-miss|always. Frack acts on production
      // so always confirm. KILLSWITCH-gated tools (kubectl_delete on
      // protected resources, git_push, send_external_email, stripe_charge,
      // stripe_refund, postiz_publish) require explicit `:y` from Leo.
      ask: "always",
      security: "allowlist",  // schema enum: deny|allowlist|full
    },
    // NOTE: the previous `confirm` array was not in the upstream
    // ToolsSchema. Per-tool confirmation now lives in the killswitch
    // persona file (KILLSWITCH.md §4) and the runtime tool allowlist:
    //   external_email, external_post, stripe_charge, stripe_refund,
    //   stripe_subscription_modify, github_push, github_pr_merge,
    //   kubectl_delete_{pvc,deployment,secret,configmap,namespace},
    //   vaultwarden_delete, postiz_publish.
  },

  skills: {
    load: {
      // Mounted from unified-ai-configs/skills/ via the frack-skills ConfigMap
      extraDirs: ["/root/.openclaw/skills"],
    },
  },

  gateway: {
    mode: "local",  // schema enum: local|remote — pod foreground == "local"
    port: 18789,
    bind: "0.0.0.0",   // expose on Service; Authelia in front
  },

  // Channels — populated from sealed `frack-secrets` env vars
  channels: {
    matrix: {
      enabled: true,
      homeserver: "https://conduit.leopaska.xyz",
      userId: "@frack:leopaska.xyz",
      accessTokenEnv: "MATRIX_ACCESS_TOKEN",
      defaultRoom: "!homelab:leopaska.xyz",
    },
    telegram: {
      enabled: true,
      botTokenEnv: "TELEGRAM_BOT_TOKEN",
      prefix: "/frack",
    },
    imessage: {
      enabled: true,
      type: "bluebubbles-proxy",
      baseUrl: "http://bluebubbles-proxy.agents-shared.svc.cluster.local:8080",
      apiKeyEnv: "BLUEBUBBLES_API_KEY",
      webhookPath: "/imessage/frack",
    },
    ntfy: {
      enabled: true,
      outboundOnly: true,
      topicUrl: "https://ntfy.leopaska.xyz/frack",
      bearerTokenEnv: "NTFY_TOKEN",
    },
  },

  // NOTE: the previous `fleet`, `hardKill`, and `quietHours` top-level
  // blocks were rejected by the upstream OpenClaw config validator
  // (root schema is .strict()). Until those features get first-class
  // schema support upstream — or we move them into a sibling config
  // file consumed by our own runtime — we keep them out of this file.
  //
  // Operational equivalents in the meantime:
  //   - HARDSTOP sentinel: HARDSTOP_PATH env + /data/HARDSTOP-FRACK is
  //     enforced by the deployment's preStop hook + persona docs.
  //   - quiet hours: enforced at the persona/skills layer (HEARTBEAT.md
  //     and the messaging adapters honour 23:00-07:00 NY).
  //   - fleet event bus: agents emit events directly to the postgres
  //     `fleet` DB via FLEET_DATABASE_URL env when scripts/skills do so;
  //     no per-agent OpenClaw-managed connection until upstream supports it.
}
