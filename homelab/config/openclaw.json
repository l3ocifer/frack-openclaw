{
  // OpenClaw config for Frack — cluster-resident on `thebeast`.
  // The business operator. Runs the 12 production apps + customer
  // ops + social + finance.
  //
  // Was previously laptop-resident (M1 Max). 2026-04-30 migrated to
  // a Deployment in the K3s cluster scheduled to thebeast.
  // The MacBook keeps `openclaw` installed as a thin client only.

  models: {
    mode: "merge",
    providers: {
      // Override the built-in `openai` provider so the OpenClaw embedded
      // harness — which falls back to `openai/gpt-5.5` for skill creation,
      // commit-message synthesis, etc. when the agentRuntime is left
      // unspecified — routes through the same LiteLLM gateway as the
      // main agent. The matching `gpt-5.5 -> chat` alias lives in
      // ~/git/homelab/argocd/apps/_inference/40-litellm-config.yaml
      // (model_group_alias). Without this override the embedded run
      // hits api.openai.com directly with our LITELLM_API_KEY -> 401.
      openai: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "OPENAI_API_KEY" },
        api: "openai-completions",
        // Cluster-internal LiteLLM resolves to a private Service IP; the
        // model-fetch SSRF guard blocks private/internal targets unless we
        // opt in for this operator-controlled endpoint. Without this the
        // embedded harness fails every call with SsrFBlockedError.
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "gpt-5.5",
            name: "Embedded harness fallback — alias to LiteLLM chat",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32768,
            maxTokens: 8192,
          }
        ]
      },
      litellm: {
        baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
        apiKey: { source: "env", provider: "default", id: "LITELLM_API_KEY" },
        api: "openai-completions",
        // See note on the openai provider above — allow the SSRF guard to
        // reach the cluster-internal LiteLLM Service (private ClusterIP).
        request: { allowPrivateNetwork: true },
        models: [
          {
            id: "chat",
            name: "Frack default chat (vllm-chat / Qwen3.5 27B AWQ)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            // 32768 (was 20480): the embedded harness mid-turn precheck pins its
            // reserve at 16384 regardless of compaction.reserveTokens, and
            // minPromptBudget=8000. At 20480 that left a negative/near-zero prompt
            // budget and wedged multi-message a2a mission threads in a
            // compact->truncate->retry loop (same class of bug fixed on puck
            // 2026-06-03). 32768 yields promptBudget=16384; worst-case request
            // 16384 prompt + 4096 output = 20480 stays under vllm-chat
            // max_model_len 24576 (no backend overflow for normal traffic).
            contextWindow: 32768,
            maxTokens: 4096,
          },
          {
            id: "long",
            name: "Long context (vllm-long / Qwen3.5 9B AWQ + DeltaNet, 262K)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 262144,
            maxTokens: 8192,
          },
          {
            id: "frontier",
            name: "Frontier (Qwen3-Coder 480B MoE on blade, slow / opt-in)",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 65536,
            maxTokens: 8192,
          },
          {
            id: "embed",
            name: "LiteLLM embed (tei-embed)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 8192,
          },
          {
            id: "rerank",
            name: "LiteLLM rerank (tei-rerank)",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 8192,
          },

          // ─── Claude Max (via household claude-bridge) ──────────────
          // Tier-4 budget share: 12% of weekly Claude pool. Frack runs
          // the production business; the budget is meant for cases
          // where customer-facing wording, financial calculations, or
          // policy-sensitive replies need the bigger model:
          //   - draft replies to escalated customer emails
          //   - quarterly financial summary / tax-prep extracts
          //   - changelog/release-notes synthesis across many PRs
          // Routine ops stays on `chat`. Bridge policy enforces both
          // the household 7-day quota and Frack's 12% share. The agent
          // may choose any Claude Code model at call time via
          // claude-code/<cli-model>; on 429 LiteLLM falls back locally.
          {
            id: "claude-sonnet-max",
            name: "Claude Sonnet 4.6 via household Max subscription",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
          {
            id: "claude-opus-max",
            name: "Claude Opus 4.7 via household Max subscription",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
          {
            id: "claude-code/*",
            name: "Claude Code model selected at call time",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      model: {
        // Fleet default: chat (vllm-chat / Qwen3.5 27B AWQ on thebeast).
        // Long/frontier are opt-in per-task only; do not auto-fallback to
        // long because a wedged long backend can hang normal agent work.
        primary: "litellm/chat",
        fallbacks: [],
      },
      // NOTE: previous `agentRuntime: { defaults: {...} }` was rejected
      // (AgentRuntimePolicySchema only accepts {id, fallback}). The main
      // model.primary above ("litellm/chat") is what the embedded
      // harness now uses, since OpenClaw inherits the agent's model
      // when no per-runtime override exists.
      workspace: "/root/.openclaw/workspace",
      compaction: { mode: "safeguard" },
      contextPruning: { mode: "cache-ttl", ttl: "1h" },
      maxConcurrent: 4,
      thinkingDefault: "low",
      heartbeat: {
        // Schedule: :10 and :40 (offset from Frick :00/:30 and Sancho :20/:50).
        // The actual cron offset is enforced by the gateway's cron runner;
        // this block only sets the cadence + target string.
        every: "30m",
        target: "last",
      },
      memorySearch: {
        enabled: true,
        sources: ["memory", "sessions"],
        // Multi-graph: own graph (RW), Leo's PKM (R+restricted W),
        // siblings R-only. Mounted via hostPath on thebeast.
        extraPaths: [
          "/srv/graphs/frack/pages/ai-memory",
          "/srv/graphs/frack/journals",
          "/srv/graphs/frack/pages",
          "/srv/graphs/leo/pages",
          "/srv/graphs/leo/journals",
          "/srv/graphs/frick/pages/ai-memory",
          "/srv/graphs/frick/journals",
          "/srv/graphs/sancho/pages/ai-memory",
          "/srv/graphs/sancho/journals",
        ],
        // Embedding provider — point `remote.baseUrl` at LiteLLM's
        // OpenAI-compatible /v1 endpoint and use the `embed` model.
        provider: "remote",
        remote: {
          baseUrl: "http://litellm.inference.svc.cluster.local:4000/v1",
          apiKey: { source: "env", provider: "default", id: "LITELLM_API_KEY" },
        },
        model: "embed",
        fallback: "local",
        local: {
          modelPath: "hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf",
        },
        // SQLite-backed vector store on the agent's writable workspace.
        // Postgres-pgvector is not in the upstream MemorySearchStoreSchema;
        // session memory continues to live in the postgres `frack_memory`
        // schema via the agent's own SQL adapters (DATABASE_URL env).
        store: {
          driver: "sqlite",
          path: "/root/.openclaw/workspace-rw/memory/index.sqlite",
          vector: { enabled: true },
        },
        sync: {
          watch: true,
          watchDebounceMs: 2000,
          onSessionStart: true,
          onSearch: true,
        },
        query: {
          hybrid: {
            enabled: true,
            vectorWeight: 0.7,
            textWeight: 0.3,
          },
        },
      },
    },
    list: [
      {
        id: "main",
        default: true,
        identity: {
          name: "Frack",
          theme: "business operator — runs the 12 production apps + customer ops + social + finance",
          emoji: "💼",
        },
      }
    ],
  },

  tools: {
    profile: "full",  // schema enum: minimal|coding|messaging|full. Frack runs production.
    allow: ["read", "exec", "write", "edit", "web_search", "browser"],
    exec: {
      host: "gateway",
      // ASK MODE: schema enum off|on-miss|always. Full fleet autonomy
      // (operator decision 2026-06-03): Frack runs unattended in a sandboxed
      // pod, so per-command prompts wedge mission turns (no interactive
      // approver). ask:"off" = never prompt. KILLSWITCH.md still gates the
      // genuinely destructive *external* tools (kubectl_delete on protected
      // resources, git_push, send_external_email, stripe_charge, stripe_refund,
      // postiz_publish) with an explicit `:y`, so production-mutating external
      // actions remain confirmed even with local exec autonomous.
      ask: "off",
      security: "full",  // schema enum: deny|allowlist|full — allow any local command in-pod
    },
    // NOTE: the previous `confirm` array was not in the upstream
    // ToolsSchema. Per-tool confirmation now lives in the killswitch
    // persona file (KILLSWITCH.md §4) and the runtime tool allowlist:
    //   external_email, external_post, stripe_charge, stripe_refund,
    //   stripe_subscription_modify, github_push, github_pr_merge,
    //   kubectl_delete_{pvc,deployment,secret,configmap,namespace},
    //   vaultwarden_delete, postiz_publish.
  },

  skills: {
    load: {
      // Mounted from unified-ai-configs/skills/ via the frack-skills ConfigMap
      extraDirs: ["/root/.openclaw/skills"],
    },
  },

  gateway: {
    mode: "local",  // schema enum: local|remote — pod foreground == "local"
    port: 18789,
    // Upstream OpenClaw tightened the schema (2026-05): bind must be one of
    // auto|lan|loopback|custom|tailnet. `lan` binds 0.0.0.0 on cluster-internal
    // interfaces, which is what the Service in front of us expects.
    bind: "lan",   // expose on Service; Authelia in front
  },

  // NOTE: channels intentionally omitted. The upstream channel-plugin
  // config schemas (matrix, telegram, bluebubbles) expect a far richer
  // account-based shape than our previous flat config — apiKeyEnv, the
  // imessage proxy block, and ntfy entirely are all rejected by the
  // current validators. Each channel plugin auto-discovers its
  // credentials from env vars at boot:
  //   matrix:      MATRIX_HOMESERVER + MATRIX_USER_ID + MATRIX_ACCESS_TOKEN
  //   telegram:    TELEGRAM_BOT_TOKEN
  //   bluebubbles: BLUEBUBBLES_SERVER_URL + BLUEBUBBLES_PASSWORD
  // ntfy is used directly via outbound HTTP from skills/scripts (it's
  // not a registered openclaw channel plugin).

  // NOTE: the previous `fleet`, `hardKill`, and `quietHours` top-level
  // blocks were rejected by the upstream OpenClaw config validator
  // (root schema is .strict()). Until those features get first-class
  // schema support upstream — or we move them into a sibling config
  // file consumed by our own runtime — we keep them out of this file.
  //
  // Operational equivalents in the meantime:
  //   - HARDSTOP sentinel: HARDSTOP_PATH env + /data/HARDSTOP-FRACK is
  //     enforced by the deployment's preStop hook + persona docs.
  //   - quiet hours: enforced at the persona/skills layer (HEARTBEAT.md
  //     and the messaging adapters honour 23:00-07:00 NY).
  //   - fleet event bus: agents emit events directly to the postgres
  //     `fleet` DB via FLEET_DATABASE_URL env when scripts/skills do so;
  //     no per-agent OpenClaw-managed connection until upstream supports it.
}
